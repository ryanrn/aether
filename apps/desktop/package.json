{
  "name": "@aether/desktop",
  "version": "0.1.15",
  "private": true,
  "description": "Aether — voz, tela e chat",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "npm run build:native && electron-builder --win --publish never",
    "typecheck": "echo \"@aether/desktop e JavaScript puro; sem typecheck\"",
    "release": "npm run build:native && electron-builder --win --publish always",
    "diagnose:audio": "electron diagnose-audio.js",
    "build:native": "cd native && npx --yes node-gyp@11 rebuild --target=44.0.0 --arch=x64 --dist-url=https://electronjs.org/headers"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Ryan",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
