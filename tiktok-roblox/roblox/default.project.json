{
  "name": "TikTokLiveBridge",
  "globIgnorePaths": ["**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TikTokBridge": {
        "$path": "src/ServerScriptService/TikTokBridge.server.luau"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "TikTok": {
        "$path": "src/ServerStorage/TikTok"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "AntiAfk": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/AntiAfk.client.luau"
        }
      }
    }
  }
}
