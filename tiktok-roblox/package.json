{
  "name": "aether-tiktok-roblox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ponte TikTok LIVE -> Roblox: le a live, vira acao dentro do jogo.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "sim": "node --env-file-if-exists=.env server/src/index.ts --source=simulator",
    "verify": "node verify.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3"
  }
}
