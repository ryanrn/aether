{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /**
     * NodeNext (e nao "Bundler", como o resto do monorepo) porque este processo
     * roda direto no Node, sem bundler: `node server/src/index.ts`. O Node 22.18+
     * apaga os tipos sozinho, e para isso ele exige a extensao real no import
     * (`./env.ts`) — dai o allowImportingTsExtensions.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["server/src/**/*.ts"]
}
