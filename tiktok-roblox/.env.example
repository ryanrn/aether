# Ponte TikTok -> Roblox.
#
# Este .env fica AQUI, e nao na raiz do monorepo como o resto do projeto. Nao e
# descuido: este processo roda na maquina de quem transmite (muitas vezes outro
# computador), nao compartilha o AUTH_SECRET com ninguem e nao fala com o banco
# do Aether. Misturar os dois arquivos so aumentaria a chance de o segredo de
# sessao acabar num PC de streaming.

# --- Servidor HTTP que o Roblox consulta ---------------------------------
# 127.0.0.1 de proposito: quem expoe para a internet e o tunel (ngrok/cloudflared),
# com TLS. Trocar para 0.0.0.0 abre a fila para a rede local inteira.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080

# Arquivo com os jogos cadastrados. Recarrega sozinho ao ser salvo.
BRIDGE_GAMES_FILE=./games.json

# --- Fonte dos eventos ----------------------------------------------------
# live      = conecta de verdade no TikTok (precisa de `npm install`)
# simulator = gera comentarios falsos, para testar o jogo sem estar ao vivo
TIKTOK_SOURCE=live

# Chave da EulerStream. Opcional: sem ela a conexao usa o servidor de assinatura
# publico, que tem limite baixo e cai em live cheia.
# TIKTOK_SIGN_API_KEY=

# --- Fila -----------------------------------------------------------------
# Quantas acoes ficam guardadas por jogo. Estourou, a mais antiga sai.
QUEUE_CAPACITY=400
# Acao mais velha que isto nunca e entregue: a live ja passou do assunto, e
# despejar 3 minutos de backlog de uma vez trava o servidor do Roblox.
ACTION_TTL_MS=45000
# Teto do long polling. O HttpService do Roblox corta em 30s; ficamos abaixo.
LONG_POLL_MAX_MS=20000

# --- Limites por espectador ----------------------------------------------
VIEWER_RATE_CAPACITY=4
VIEWER_RATE_REFILL_PER_SEC=0.5
GLOBAL_RATE_PER_SEC=25
DEDUPE_WINDOW_MS=3000

# --- Push opcional via Open Cloud (MessagingService) ----------------------
# Corta a latencia do polling para ~1s em jogo PUBLICADO. Sem isto, o Roblox so
# recebe via long polling (que ja e rapido). Nao funciona no Studio.
# ROBLOX_OPEN_CLOUD_KEY=

LOG_LEVEL=info
