{
  "name": "aether-comms",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de comunicacao em tempo real (voz, tela e texto) — nome definitivo a definir",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- npm run dev --workspace=@aether/web",
    "dev:realtime": "dotenv -e .env -- npm run dev --workspace=@aether/realtime",
    "dev:desktop": "npm run dev --workspace=@aether/desktop",
    "build:desktop": "npm run build --workspace=@aether/desktop",
    "release:desktop": "node scripts/release-desktop.mjs",
    "build": "npm run db:generate && dotenv -e .env -- npm run build --workspace=@aether/web",
    "build:ci": "prisma generate --schema packages/db/prisma/schema.prisma && npm run build --workspace=@aether/web",
    "start": "dotenv -e .env -- npm run start --workspace=@aether/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:esm": "tsx scripts/checa-esm.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "build:worklet": "node scripts/build-rnnoise-worklet.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "node scripts/check-env.js .env",
    "db:password": "node scripts/set-db-password.js",
    "db:diagnose": "node scripts/diagnose-db.js",
    "db:generate": "dotenv -e .env -- npm run generate --workspace=@aether/db",
    "db:push": "dotenv -e .env -- npm run push --workspace=@aether/db",
    "db:migrate": "dotenv -e .env -- npm run migrate --workspace=@aether/db",
    "db:deploy": "dotenv -e .env -- node scripts/deploy-migracoes.mjs",
    "db:deploy:raw": "dotenv -e .env -- npm run deploy --workspace=@aether/db",
    "db:studio": "dotenv -e .env -- npm run studio --workspace=@aether/db",
    "db:seed": "dotenv -e .env -- npm run seed --workspace=@aether/db",
    "backup": "dotenv -e .env -- node scripts/backup.mjs",
    "backup:verify": "dotenv -e .env -- node scripts/verify-backup.mjs",
    "restore": "dotenv -e .env -- node scripts/restore.mjs",
    "design": "node design-lab/serve.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "prisma@6.19.2": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "electron@44.0.0": true,
    "electron-winstaller@5.4.0": false
  }
}
