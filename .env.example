# =============================================================================
# Copie este arquivo para .env NA RAIZ do monorepo e preencha os valores.
# Todos os comandos (Prisma e Next) leem este arquivo via dotenv-cli.
# .env NUNCA vai para o git.
#
# Para a senha do banco, prefira:  npm run db:password -- "senha-crua"
# (aplica o percent-encoding sozinho — senha com @ / ? & quebra a URL)
# =============================================================================

# --- Banco de dados (Postgres) ----------------------------------------------
# Projeto Supabase ja criado: aether-comms (regiao sa-east-1)
#
# Onde pegar:
#   https://supabase.com/dashboard/project/yrdyydyldkqhvawevyxu/settings/database
#   1. Clique em "Reset database password" e guarde a senha gerada.
#   2. Em "Connection string", copie a URI do modo "Transaction pooler"
#      -> vai em DATABASE_URL (porta 6543, adicione ?pgbouncer=true)
#   3. Copie a URI de "Direct connection" (porta 5432)
#      -> vai em DIRECT_URL  (o Prisma usa esta para rodar migrations)
#
#   Em PRODUCAO suba o connection_limit para pelo menos 5: o gateway faz uma
#   consulta por mensagem enviada, e com limite 1 elas serializam.
DATABASE_URL="postgresql://postgres.yrdyydyldkqhvawevyxu:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.yrdyydyldkqhvawevyxu:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Sessao ------------------------------------------------------------------
# Chave de assinatura do JWT de sessao. MINIMO 32 caracteres.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- URLs --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Gateway WebSocket ------------------------------------------------------
# Em desenvolvimento os padroes bastam: porta 4000 e origem NEXT_PUBLIC_APP_URL.
# O gateway usa o MESMO AUTH_SECRET e o MESMO DATABASE_URL acima — e assim que
# ele valida a sessao do app sem ter login proprio.
# REALTIME_PORT="4000"
#
# EM PRODUCAO esta variavel e OBRIGATORIA no ambiente do app web: e o endereco
# que o navegador usa para abrir o WebSocket. Sem ela o cliente cai no padrao
# localhost e nada conecta. Ver DEPLOY.md.
# NEXT_PUBLIC_REALTIME_URL="https://seu-gateway.fly.dev"

# --- SFU de voz e tela (LiveKit) --------------------------------------------
# Os tres juntos, ou nenhum: configuracao pela metade falha no boot do gateway.
# Sem eles o app funciona normalmente, so sem audio.
# LIVEKIT_URL="wss://seu-projeto.livekit.cloud"
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# --- Supabase Storage (icone de servidor) -----------------------------------
# O upload de icone grava no bucket `server-icons` do MESMO projeto Supabase
# que ja hospeda o banco. Bucket publico para leitura; a escrita passa so pela
# service_role key, que ignora RLS — quem autoriza e a Server Action
# (requirePermission MANAGE_SERVER), nao uma policy.
#
# Onde pegar a chave:
#   https://supabase.com/dashboard/project/yrdyydyldkqhvawevyxu/settings/api-keys
#   Copie a chave "service_role" (secret). NUNCA a exponha no cliente: ela
#   ignora toda a seguranca do banco. Por isso nao tem prefixo NEXT_PUBLIC_.
#
# Sem estas duas, o app sobe normalmente e o upload de icone responde que nao
# esta configurado — nada mais quebra.
SUPABASE_URL="https://yrdyydyldkqhvawevyxu.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (rate limit distribuido e consumo unico de ticket) ---------------
# OPCIONAIS. Sem elas o rate limit cai para memoria e o consumo de ticket
# tambem — correto em desenvolvimento (um processo so), mas NAO em producao na
# Vercel, onde cada instancia serverless tem o proprio contador.
#
# Onde pegar: crie um banco no Upstash (https://console.upstash.com) e copie o
# par "REST API" — URL e TOKEN. E a API HTTP, nao a porta 6379: funcao
# serverless nao aguenta conexao TCP persistente.
#
# O MESMO par serve para o gateway na Fly (consumo unico de ticket entre
# instancias). Envie com: node scripts/fly-secrets.mjs <url-da-vercel>
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Envio de e-mail (recuperacao de senha) — Resend
#
# Sem estes dois, o app SOBE e funciona: o pedido de redefinicao responde
# normalmente (a resposta e a mesma de qualquer jeito, para nao revelar quem
# tem conta) e, em desenvolvimento, o link aparece no console do servidor.
#
# EMAIL_FROM precisa ser de um dominio verificado no Resend. Sem dominio
# proprio da para usar o remetente de teste deles: onboarding@resend.dev
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="AETHER <onboarding@resend.dev>"
