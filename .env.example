# =============================================================================
# Copie este arquivo para .env NA RAIZ do monorepo e preencha os valores.
# Todos os comandos (Prisma e Next) leem este arquivo via dotenv-cli.
# .env NUNCA vai para o git.
#
# Para a senha do banco, prefira:  npm run db:password -- "senha-crua"
# (aplica o percent-encoding sozinho — senha com @ / ? & quebra a URL)
# =============================================================================

# --- Banco de dados (Postgres) ----------------------------------------------
# Projeto Supabase ja criado: aether-comms (regiao sa-east-1)
#
# Onde pegar:
#   https://supabase.com/dashboard/project/yrdyydyldkqhvawevyxu/settings/database
#   1. Clique em "Reset database password" e guarde a senha gerada.
#   2. Em "Connection string", copie a URI do modo "Transaction pooler"
#      -> vai em DATABASE_URL (porta 6543, adicione ?pgbouncer=true)
#   3. Copie a URI de "Direct connection" (porta 5432)
#      -> vai em DIRECT_URL  (o Prisma usa esta para rodar migrations)
#
DATABASE_URL="postgresql://postgres.yrdyydyldkqhvawevyxu:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.yrdyydyldkqhvawevyxu:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Sessao ------------------------------------------------------------------
# Chave de assinatura do JWT de sessao. MINIMO 32 caracteres.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- URLs --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- FASE 3 (gateway WebSocket) ---------------------------------------------
# Opcionais: o gateway assume 4000 e libera a origem de NEXT_PUBLIC_APP_URL.
# O gateway usa o MESMO AUTH_SECRET e o MESMO DATABASE_URL acima — e assim que
# ele valida o cookie de sessao do app sem ter login proprio.
# REALTIME_PORT="4000"
# NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"   # o caminho do socket e /ws

# --- FASE 4/5 (SFU de voz e tela) -------------------------------------------
# LIVEKIT_URL=""
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""
