// Schema unico do sistema. Modelado ja pensando nas fases seguintes para que
// nenhuma fase precise reescrever tabela existente — apenas usar o que ja existe.
//
// FASE 1 usa: User, Session, Server, ServerMember, Role, MemberRole, Category,
//             Channel, Invite, AuditLog
// FASE 2 usa: ChannelOverwrite (canais privados por cargo/membro)
// FASE 3 usa: Message
// FASE 6 usa: Ban, AuditLog (expandido)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum ChannelType {
  TEXT
  VOICE
}

enum OverwriteTarget {
  ROLE
  MEMBER
}

model User {
  id                        String     @id @default(cuid())
  username                  String     @unique
  displayName               String
  email                     String     @unique
  passwordHash              String
  /// Quando o e-mail foi confirmado. Nulo = nao confirmado — a conta existe e
  /// loga, mas bate numa parede ("confirme seu e-mail") enquanto a flag
  /// `exige_email_verificado` estiver ligada. Ver `@aether/access/verificacao`.
  emailVerificadoEm         DateTime?
  /// Aceite dos Termos/Privacidade. `aceitouTermosEm` nulo, ou `termosVersao`
  /// diferente da versao atual em `@aether/shared/legal`, dispara o modal de
  /// aceite em `/app`. Guardar a VERSAO permite pedir re-aceite quando os
  /// termos mudam de verdade, sem forcar todo mundo a cada ajuste de texto.
  aceitouTermosEm           DateTime?
  termosVersao              String?
  /// Silenciamento GLOBAL (nao e por servidor — isso e `Ban`). Nulo = solto.
  /// Quem esta silenciado nao manda mensagem em lugar nenhum (gateway e web
  /// revalidam), mas continua lendo. Decidido pela equipe a partir de uma
  /// denuncia. `silenciadoAte` nulo com `silenciadoEm` preenchido = indefinido.
  silenciadoEm              DateTime?
  silenciadoAte             DateTime?
  silenciadoPor             String?
  silenciadoMotivo          String?
  /// Administracao GLOBAL do produto — nao tem nada a ver com dono de
  /// servidor, que e por servidor e ja existe.
  ///
  /// Hoje governa uma coisa so: quem revisa a fila de jogos sugeridos. Fica
  /// como coluna, e nao como lista de ids numa variavel de ambiente, pelo
  /// mesmo motivo do plano — conceder e um comando (`definir-equipe.mjs`), e
  /// nao um redeploy.
  ///
  /// A regra de LEITURA disto mora em `@aether/access`, e nao espalhada em
  /// comparacoes de username pelas telas.
  equipe                    Boolean    @default(false)
  avatarUrl                 String?
  /// O mesmo avatar, PARADO — gerado no envio quando o arquivo e animado.
  ///
  /// Existe para que perder o plano tire a ANIMACAO sem tirar a foto. Apagar
  /// o arquivo animado seria destruir dado da pessoa; deixar animando seria
  /// entregar de graca o que e do plano de cima. Guardando os dois, a leitura
  /// escolhe, e reativar devolve o movimento sem novo envio.
  ///
  /// Nulo quando o avatar nunca foi animado — nesse caso `avatarUrl` ja e
  /// parado, e nao ha o que escolher.
  avatarEstaticoUrl         String?
  /// A moldura de avatar ESCOLHIDA, e nao a que esta valendo.
  ///
  /// Quem escolhe uma moldura paga e depois deixa de pagar continua com a
  /// escolha guardada aqui; quem decide se ela aparece e a LEITURA
  /// (`molduraEfetiva`), do mesmo jeito que o vencimento do plano. Apagar a
  /// linha ao vencer obrigaria a pessoa a lembrar qual era ao voltar.
  ///
  /// Guarda o id do catalogo em codigo (`MOLDURAS`), nao o visual. Moldura
  /// retirada do catalogo vira nulo na leitura, sem quebrar a tela.
  molduraId                 String?
  /// Bio do perfil GLOBAL — texto curto que a pessoa escreve sobre si. Nulo =
  /// nunca preencheu; string vazia nao e guardada (a action apaga). Aparece no
  /// cartao de perfil; nao viaja no `PublicUser` (seria peso em toda mensagem)
  /// — o cartao busca sob demanda.
  bio                       String?
  status                    UserStatus @default(OFFLINE)
  /// Aceita conversa direta de quem NAO e amigo, mas divide um servidor.
  ///
  /// Ligado por padrao: e o comportamento que as pessoas esperam de um app de
  /// comunidade, e quem incomoda ainda pode desligar. Amizade passa por cima
  /// disto — esta chave so governa o caminho "conheci num servidor".
  allowServerDms            Boolean    @default(true)
  /// Aceita PEDIDO DE AMIZADE de quem divide um servidor.
  ///
  /// Separada de `allowServerDms` de proposito: sao decisoes diferentes. Da
  /// para querer receber pedido de amizade e nao querer conversa direta de
  /// estranho, e o contrario tambem. Uma chave so obrigaria as duas a andarem
  /// juntas.
  ///
  /// Nao afeta o caminho por NOME DE USUARIO EXATO: quem passou o proprio nome
  /// para alguem ja decidiu ser encontravel por ali.
  allowServerFriendRequests Boolean    @default(true)
  lastSeenAt                DateTime   @default(now())
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  sessions           Session[]
  passwordResets     PasswordReset[]
  verificacoesEmail  VerificacaoEmail[]
  denunciasFeitas    Denuncia[]         @relation("DenunciaReporter")
  friendsAsRequester Friendship[]        @relation("FriendshipRequester")
  friendsAsAddressee Friendship[]        @relation("FriendshipAddressee")
  dmsComoA           DmChannel[]         @relation("DmUserA")
  dmsComoB           DmChannel[]         @relation("DmUserB")
  bloqueiosFeitos    Block[]             @relation("Blocker")
  bloqueiosRecebidos Block[]             @relation("Blocked")
  reacoes            Reaction[]
  memberships        ServerMember[]
  ownedServers       Server[]            @relation("ServerOwner")
  assinatura         Subscription?
  resgatesDeChave    PlanKeyRedemption[]
  anexos             Attachment[]
  messages           Message[]
  createdInvites     Invite[]
  auditEntries       AuditLog[]          @relation("AuditActor")
  bans               Ban[]               @relation("BannedUser")
  issuedBans         Ban[]               @relation("BanIssuer")
  jogosSugeridos     SugestaoDeJogo[]
  conexoes           Connection[]

  @@index([status])
}

/// Um servico externo que pode ser ligado a uma conta do Aether.
///
/// Vira um TYPE no Postgres. Adicionar um valor aqui e uma migracao — de
/// proposito: provedor novo exige cadastro de aplicativo, segredo em producao
/// e codigo de login, entao nao pode ser algo que entre por engano numa
/// string solta.
enum ConnectionProvider {
  SPOTIFY
  STEAM
  TWITCH
  RIOT
}

/// Conta de outro servico ligada a um usuario do Aether.
///
/// SUBSTITUIU `SpotifyAccount`, que tinha `userId` como PK — formato de
/// "Spotify", nao de "conexao". Para somar Steam, Twitch e Riot seriam mais
/// tres tabelas quase iguais e mais tres copias de cada modulo (~970 linhas
/// por servico, medido).
///
/// OS QUATRO NAO TEM O MESMO FORMATO, e o modelo precisa aguentar isso:
///  - Spotify e Twitch: OAuth 2.0, com token e refresh;
///  - Steam: OpenID 2.0 — autentica mas NAO devolve token de usuario, por
///    isso os campos de token sao opcionais;
///  - Riot: so identidade (nao ha API publica de presenca).
///
/// Os tokens ficam CIFRADOS pela aplicacao (AES-256-GCM, chave derivada do
/// AUTH_SECRET — ver `secret-box.ts`) antes de chegarem aqui: refresh token
/// da acesso continuo a conta da pessoa e nao pode ficar em claro no banco.
model Connection {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      ConnectionProvider
  /// O id da pessoa NO SERVICO.
  ///
  /// Opcional porque as linhas migradas do `SpotifyAccount` nao tem — aquela
  /// tabela so guardava o nome. As novas preenchem; as antigas preenchem na
  /// proxima vez que a pessoa reconectar.
  externalId    String?
  /// nome de exibicao no servico, so para a tela de configuracoes
  displayName   String?
  /// nulos em provedor sem token de usuario (Steam)
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  scope         String?
  /// aparece no cartao de atividade / painel "Ativo agora"
  showOnProfile Boolean            @default(true)
  /// substitui o texto de status (ex.: "Ouvindo Spotify")
  showAsStatus  Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  /// uma conta por servico, por pessoa
  @@unique([userId, provider])
  /// IMPEDE DUAS CONTAS DO AETHER REIVINDICAREM O MESMO PERFIL EXTERNO.
  /// Sem isto, alguem liga o Steam de outra pessoa e se passa por ela no
  /// perfil. (`NULL` nao colide com `NULL` no Postgres, entao as linhas
  /// migradas sem `externalId` convivem ate serem preenchidas.)
  @@unique([provider, externalId])
  @@index([provider])
}

/// Sessao persistida. O cookie carrega um JWT assinado contendo o id da sessao;
/// manter a linha no banco permite revogar acesso (logout global, ban, troca de senha).
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Server {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String?
  ownerId   String
  owner     User     @relation("ServerOwner", fields: [ownerId], references: [id])

  /// Em que ponto este servidor esta na vitrine.
  ///
  /// NAO E UM BOOLEANO, e a diferenca e a licao: a primeira versao deixava o
  /// dono se listar sozinho. Como qualquer pessoa cria conta e servidor, isso
  /// abria a vitrine para spam — e, pior, para alguem criar um servidor
  /// chamado "AETHER OFICIAL" e ficar ao lado do nosso. Selo protege o nome,
  /// mas muita gente nao olha selo.
  ///
  /// O dono PEDE (PENDENTE); a equipe decide. Mesma regra da biblioteca de
  /// jogos: o que aparece para todo mundo passa por revisao.
  vitrine   VitrineStatus @default(PRIVADO)

  /// Quem revisou o pedido, e quando. Decisao que vale para a base inteira
  /// precisa ter dono.
  vitrineRevisadaPor String?
  vitrineRevisadaEm  DateTime?

  /// A frase que aparece no card da vitrine. Nula ate o dono escrever.
  descricao String?

  /// O id de uma categoria do catalogo em codigo (`CATEGORIAS_DE_COMUNIDADE`).
  ///
  /// Id, e nao texto livre: texto livre fragmenta em "Games", "Gaming",
  /// "gaming" e "JOGOS", e a vitrine vira uma lista de categorias com um
  /// servidor cada.
  categoria String?

  /// Servidor OFICIAL do Aether — fixado no topo da vitrine, com selo.
  ///
  /// So a EQUIPE marca (`scripts/definir-servidor-oficial.mjs`), nunca o dono:
  /// selo que o proprio interessado se da nao vale nada, e viraria enfeite no
  /// primeiro dia em que alguem descobrisse a chave.
  oficial   Boolean  @default(false)

  /// Liga o cargo automatico por jogo (fase 2, estagio 2).
  ///
  /// DESLIGADO por padrao, e por escolha do dono: o recurso mexe no cargo de
  /// terceiro sozinho, entao so entra em servidor que pediu. Ligado, quem
  /// esta com um jogo aberto recebe — enquanto joga — o cargo que o dono
  /// vinculou aquele jogo (ver `Role.jogoNormalizado`).
  cargoPorJogo Boolean @default(false)

  /// Permite membros criarem salas de grupo (LFG) por jogo (fase 2, estagio 3).
  ///
  /// DESLIGADO por padrao: sala de grupo e canal de voz que qualquer membro
  /// cria, e sem limite isso e vetor de bagunca. Ligado, o membro cria uma
  /// sala `isTemporary` marcada com o jogo; ela some quando esvazia.
  salasDeGrupo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    ServerMember[]
  roles      Role[]
  categories Category[]
  channels   Channel[]
  invites    Invite[]
  bans       Ban[]
  auditLogs  AuditLog[]

  @@index([ownerId])
  /// A vitrine filtra sempre por publico; sem indice ela varre a tabela.
  /// O campo oficial entra junto porque a ordenacao fixa os oficiais no topo.
  @@index([vitrine, oficial])
}

model ServerMember {
  id       String   @id @default(cuid())
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname String?
  /// Ordem do servidor no trilho DESTA pessoa.
  ///
  /// Por membro, e nao no proprio Server: a ordem do trilho e uma preferencia
  /// de quem olha. Guardar no servidor faria arrastar um icone reordenar a
  /// tela de todo mundo que e membro dele.
  ///
  /// Empate cai no `joinedAt`, que era o criterio unico antes desta coluna —
  /// com todos em 0 (o padrao), a ordem existente nao muda.
  position Int      @default(0)
  joinedAt DateTime @default(now())

  roles      MemberRole[]
  overwrites ChannelOverwrite[] @relation("MemberOverwrite")

  @@unique([serverId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#9AA6B8")
  /// bitfield de permissoes (ver packages/shared/src/permissions.ts)
  permissions BigInt   @default(0)
  /// hierarquia: maior position = cargo mais alto
  position    Int      @default(0)
  /// cargo atribuido automaticamente a todo novo membro
  isDefault   Boolean  @default(false)
  /// cargo intocavel do dono
  isOwner     Boolean  @default(false)

  /// Nome do jogo que da este cargo automaticamente, como o dono digitou.
  /// Nulo = cargo comum. So surte efeito com `Server.cargoPorJogo` ligado.
  jogoVinculado   String?
  /// A forma canonica de `jogoVinculado` (`normalizarNome` de @aether/shared).
  /// E por ela que o gateway casa o nome que chega do detector, sem depender
  /// de grafia. Indexada porque o gateway consulta a cada troca de jogo.
  jogoNormalizado String?

  createdAt   DateTime @default(now())

  members    MemberRole[]
  overwrites ChannelOverwrite[] @relation("RoleOverwrite")

  @@unique([serverId, name])
  @@index([serverId, position])
  @@index([serverId, jogoNormalizado])
}

model MemberRole {
  memberId   String
  member     ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([memberId, roleId])
  @@index([roleId])
}

model Category {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  channels Channel[]

  @@index([serverId, position])
}

model Channel {
  id          String      @id @default(cuid())
  serverId    String
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  topic       String?
  type        ChannelType
  position    Int         @default(0)
  /// canal privado: so quem tem overwrite de allow enxerga
  isPrivate   Boolean     @default(false)
  /// canal temporario: o gateway remove quando esvazia (fase 2, estagio 3)
  isTemporary Boolean     @default(false)
  /// sala de grupo (LFG): o jogo que ela junta. null = canal comum.
  jogo        String?
  /// quem criou a sala de grupo — janela de carencia criar->entrar e "sua sala"
  criadaPor   String?
  /// limite de usuarios simultaneos em voz (null = ilimitado)
  userLimit   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  messages   Message[]
  overwrites ChannelOverwrite[]

  @@index([serverId, position])
  @@index([categoryId])
  /// a varredura de salas efemeras filtra por (servidor, temporario)
  @@index([serverId, isTemporary])
}

/// Excecoes de permissao por canal — base dos canais privados (fase 2).
model ChannelOverwrite {
  id        String          @id @default(cuid())
  channelId String
  channel   Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  target    OverwriteTarget
  roleId    String?
  role      Role?           @relation("RoleOverwrite", fields: [roleId], references: [id], onDelete: Cascade)
  memberId  String?
  member    ServerMember?   @relation("MemberOverwrite", fields: [memberId], references: [id], onDelete: Cascade)
  allow     BigInt          @default(0)
  deny      BigInt          @default(0)

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
  @@index([channelId])
}

/// Mensagens de canal de texto (fase 3).
/// Uma mensagem pertence a UM canal de servidor OU a UMA conversa direta —
/// nunca aos dois, nunca a nenhum. Quem garante isso e um CHECK no banco
/// (ver a migracao 20260826..._dm), porque convencao em codigo nao sobrevive
/// ao primeiro caminho novo de escrita.
///
/// Por que uma tabela so, e nao uma `DirectMessage` separada: hoje a logica de
/// mensagem e fina (um create, duas leituras), mas editar, apagar e responder
/// vao chegar. Com duas tabelas eles chegam duas vezes, e duas copias da mesma
/// regra divergem.
model Message {
  id          String     @id @default(cuid())
  channelId   String?
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dmChannelId String?
  dmChannel   DmChannel? @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String     @db.Text
  replyToId   String?
  replyTo     Message?   @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]  @relation("MessageReply")
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())

  reactions Reaction[]
  anexos    Attachment[]

  @@index([channelId, createdAt])
  @@index([dmChannelId, createdAt])
  @@index([authorId])
}

/// Reacao de uma pessoa a uma mensagem.
///
/// O `@@unique` e o coracao do modelo: ele faz "uma reacao por pessoa, por
/// emoji, por mensagem" ser garantia do BANCO. Sem ele, clicar duas vezes
/// rapido — ou dois aparelhos da mesma pessoa ao mesmo tempo — criaria linhas
/// repetidas, e a contagem passaria a mentir sem nada quebrar visivelmente.
///
/// Ele tambem torna o ALTERNAR barato: em vez de "contar, decidir, gravar",
/// da para tentar criar e tratar a colisao como "ja existe, entao remova".
///
/// O emoji e guardado como TEXTO (o proprio caractere), e nao como id de um
/// catalogo. Catalogo envelhece: emoji novo entra no Unicode todo ano, e um id
/// nosso obrigaria a manter uma tabela de-para para sempre. O caractere ja e o
/// identificador universal — quem valida o que entra e `emojiSchema`.
model Reaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  /// Carregar as reacoes de uma pagina de mensagens percorre por messageId.
  @@index([messageId])
}

/// Conversa direta entre duas pessoas.
///
/// O PAR E ORDENADO: `userAId` guarda sempre o menor id e `userBId` o maior.
/// Com isso o unique de (userAId, userBId) impede de verdade que exista mais
/// de uma conversa para o mesmo par — inclusive quando os dois lados clicam ao
/// mesmo tempo, que e onde uma checagem em codigo perde.
///
/// Difere da `Friendship`, que indexa por DIRECAO, e a diferenca e proposital:
/// la o "quem pediu" precisa sobreviver, porque e ele que decide de que lado o
/// botao de aceitar aparece. Numa conversa nao ha esse lado — trocar A por B
/// nao muda nada — entao da para ordenar e deixar o banco garantir.
model DmChannel {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("DmUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("DmUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  /// A busca "minhas conversas" olha as duas colunas; sem este, metade sairia
  /// de varredura sequencial. Mesma razao dos dois indices em Friendship.
  @@index([userBId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([serverId])
}

model Ban {
  id         String    @id @default(cuid())
  serverId   String
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User      @relation("BanIssuer", fields: [issuedById], references: [id])
  reason     String?
  /// Banimento temporario. Nulo = permanente.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([serverId, userId])
  @@index([serverId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([serverId, createdAt])
}

/// Pedido de redefinicao de senha.
///
/// O token e guardado como HASH, nunca em claro. Se o banco vazar — ou o dump
/// de backup, que carrega esta tabela — token legivel deixaria qualquer um
/// redefinir qualquer conta. Mesmo raciocinio do `passwordHash`.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 do token que foi para o e-mail
  tokenHash String    @unique
  expiresAt DateTime
  /// carimbo de uso: o token vale UMA vez
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Confirmacao de e-mail. Mesma forma do `PasswordReset` de proposito: token
/// que vai para a caixa NUNCA e gravado — so o sha256 —, uso unico (`usedAt`),
/// validade curta. Um dump de backup com token legivel deixaria qualquer um
/// confirmar a conta de qualquer um.
model VerificacaoEmail {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Amizade entre duas contas.
///
/// UMA linha por par, nao duas. Duas linhas (uma por direcao) obrigariam a
/// manter as duas em acordo a cada mudanca, e duas verdades sobre a mesma
/// relacao e como uma delas fica para tras.
///
/// A consequencia e que `requesterId`/`addresseeId` guardam QUEM PEDIU, e nao
/// uma hierarquia: depois de aceito os dois lados sao iguais, e toda consulta
/// de "meus amigos" precisa olhar as duas colunas.
///
/// O par unico e por direcao. Impedir o par invertido exigiria ordenar os ids
/// na gravacao, o que tornaria "quem pediu" irrecuperavel — entao quem checa
/// se ja existe relacao nos dois sentidos e a action, antes de criar.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum GameMetadataSource {
  /// veio do IGDB
  IGDB
  /// o IGDB nao achou (ou nao esta configurado) — vale o que o detector deu
  DETECTOR
}

/// Metadados de jogo — cache COMPARTILHADO entre todo mundo.
///
/// Compartilhado de proposito: o primeiro que abre Hollow Knight resolve a
/// capa para todos os outros. Cache por maquina faria cada pessoa pagar a
/// mesma consulta, e o IGDB limita a 4 por segundo.
///
/// **Nao ha nenhuma coluna de usuario aqui, e isso e deliberado.** A tabela
/// diz "Hollow Knight tem esta capa", nunca "fulano jogou Hollow Knight".
/// Guardar quem consultou transformaria um cache de arte em um historico de
/// habitos de jogo — que e exatamente o dado que a deteccao local se recusa a
/// mandar para o servidor.
model GameMetadata {
  id String @id @default(cuid())

  /// Nome normalizado — a chave de busca. Ver `normalize.ts`.
  lookupKey    String @unique
  /// Como o detector entregou, guardado para diagnostico do casamento.
  detectedName String
  /// O que a Activity mostra.
  displayName  String

  igdbId   Int?
  coverUrl String?
  genre    String?

  source     GameMetadataSource
  /// 0..1 — quao confiavel foi o casamento com o IGDB.
  confidence Float?

  /// Quando consultamos por ultimo. E o que decide reconsultar: linha sem
  /// capa merece nova tentativa (o IGDB cadastra jogos novos), e linha com
  /// capa envelhece devagar.
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([checkedAt])
}

/// Bloqueio de uma pessoa por outra.
///
/// DIRECIONAL: uma linha por sentido. Diferente da amizade, "A bloqueou B" e um
/// fato distinto de "B bloqueou A" — os dois podem existir ao mesmo tempo, e
/// desfazer um nao desfaz o outro.
///
/// Quem consulta, porem, olha os DOIS sentidos. Checar so um deixaria quem
/// bloqueou continuar mandando mensagem para quem bloqueou, que e o oposto do
/// que isto serve.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  /// "quem me bloqueou" percorre a outra coluna; sem este indice, metade das
  /// consultas sairia em varredura sequencial. Mesma razao dos dois em Friendship.
  @@index([blockedId])
}

/// Os planos pagos. A ESCADA importa: comparacao e por posicao, nunca por
/// igualdade — `=== PLUS` esqueceria o PRO, e quem paga mais receberia menos.
enum PlanTier {
  FREE
  PLUS
  PRO
}

/// A assinatura de uma pessoa. UMA por usuario.
///
/// POR QUE UM MODEL PROPRIO, e nao dois campos no User: cobranca traz consigo
/// estado que nao e do usuario — de qual provedor veio, qual o id la, quando
/// renova, se foi cancelada mas ainda vale ate o fim do periodo. Enfiar isso
/// no User faria a tabela mais lida do sistema crescer por um motivo que nada
/// tem a ver com identidade.
///
/// AGNOSTICA DE PROVEDOR de proposito: `provedor` e `idExterno` sao opcionais
/// e ninguem os preenche ainda. Hoje o plano e concedido a mao
/// (`scripts/definir-plano.mjs`); quando entrar Stripe ou Mercado Pago, o
/// webhook deles escreve NESTAS MESMAS colunas e o resto do sistema nao muda.
model Subscription {
  id     String   @id @default(cuid())
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   PlanTier @default(FREE)

  /// Ate quando vale. NULO = sem validade, para conta concedida a mao
  /// (equipe, teste, cortesia) que nao deve virar abobora sozinha.
  ///
  /// Quem decide se venceu e a LEITURA (`planoEfetivo`), e nao um job que
  /// altera linhas: job que falha deixa a pessoa premium para sempre, e o
  /// defeito e silencioso porque favorece quem tem.
  expiraEm DateTime?

  /// De onde veio, quando vier de algum lugar. "stripe", "mercadopago"...
  provedor  String?
  /// O id da assinatura no provedor, para o webhook achar a linha.
  idExterno String?

  /// Quem concedeu a mao, quando foi a mao. Serve para auditoria — uma conta
  /// premium que ninguem pagou precisa ter dono.
  concedidoPor String?
  motivo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O webhook do provedor chega com o id DELE, nao com o nosso.
  @@index([provedor, idExterno])
}

/// Uma chave que troca por plano.
///
/// POR QUE EXISTE: dar acesso a quem nao vai pagar — sorteio, parceiro, teste,
/// amigo — sem depender de cobranca nenhuma. E o unico caminho hoje, e vai
/// continuar existindo depois que houver pagamento, porque cobranca nao
/// resolve o caso de dar de presente.
///
/// O CODIGO NAO FICA GUARDADO. Vale o mesmo raciocinio do token de
/// recuperacao de senha: uma chave e credencial ao portador, e um vazamento do
/// banco viraria plano de graca para quem lesse a tabela. Guardamos o sha256 e
/// mostramos o codigo UMA vez, na criacao.
model PlanKey {
  id String @id @default(cuid())

  /// sha256 do codigo entregue. Unico para o resgate achar a linha.
  codigoHash String @unique
  /// Os primeiros caracteres, em claro, so para reconhecer a chave numa
  /// lista ("AE-7F3K..."). Curto de proposito: nao serve para adivinhar o
  /// resto, serve para saber de qual chave se esta falando.
  prefixo    String

  tier PlanTier

  /// Por quantos dias o plano vale ao resgatar. NULO = sem validade.
  dias Int?

  /// Quantas pessoas podem resgatar. 1 = chave pessoal; N = campanha.
  maxUsos Int @default(1)
  usos    Int @default(0)

  /// Ate quando a CHAVE aceita resgate. Diferente da validade do plano: a
  /// chave pode morrer em uma semana e dar 30 dias a quem resgatar dentro
  /// dela.
  expiraEm DateTime?

  /// Cancelada a mao. Preenchida em vez de apagar a linha, para o historico
  /// dizer que existiu e foi revogada — apagar esconderia o que aconteceu.
  revogadaEm DateTime?

  criadaPor String?
  motivo    String?
  createdAt DateTime @default(now())

  resgates PlanKeyRedemption[]

  @@index([revogadaEm])
}

/// Quem resgatou qual chave.
///
/// Existe por duas razoes, e a segunda e a que importa: dar historico, e
/// impedir que a MESMA pessoa resgate a MESMA chave de campanha varias vezes.
/// Sem o par unico, uma chave de 100 usos seria 100 meses para uma pessoa so.
model PlanKeyRedemption {
  id     String  @id @default(cuid())
  keyId  String
  key    PlanKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O que a pessoa ganhou, congelado no momento do resgate — a chave pode
  /// ser revogada depois, e o historico precisa continuar dizendo a verdade.
  tierConcedido PlanTier
  expiraEm      DateTime?

  createdAt DateTime @default(now())

  @@unique([keyId, userId])
  @@index([userId])
}

/// Um arquivo anexado a uma mensagem.
///
/// A LINHA NASCE ANTES DO ARQUIVO. Quem cria e a action que autoriza o envio,
/// depois de conferir o plano — e e ela que sorteia a `chave`. O cliente nunca
/// escolhe onde grava: se escolhesse, poderia apontar para o objeto de outra
/// pessoa ou sobrescrever o proprio anexo de uma mensagem antiga.
///
/// O CICLO tem tres estados, e nenhum deles e um booleano solto:
///   1. criada aqui, `prontoEm` nulo — autorizado, ainda nao enviado;
///   2. `prontoEm` preenchido — o servidor perguntou ao R2 e o objeto esta la,
///      com o tamanho certo;
///   3. `messageId` preenchido — virou anexo de uma mensagem.
///
/// Linha que fica no passo 1 ou 2 e lixo: alguem abriu o seletor e desistiu.
/// Ela aponta para um objeto que talvez exista no bucket, e limpar isso e
/// trabalho de faxina que ainda nao existe (anotado nas limitacoes).
model Attachment {
  id String @id @default(cuid())

  /// Quem autorizou. A mensagem so aceita anexo de quem a esta enviando.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nulo ate virar anexo de uma mensagem.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Onde o objeto vive no bucket. Sorteada pelo servidor.
  chave String @unique

  /// O nome que a pessoa deu, so para exibir e baixar. NUNCA usado para montar
  /// caminho — nome de arquivo com `../` viraria travessia de diretorio.
  nome String

  /// O tipo com que o objeto foi GRAVADO, que nao e necessariamente o que o
  /// navegador declarou: o que nao for imagem, video ou audio conhecido vira
  /// `application/octet-stream`, para o bucket publico nao servir HTML como
  /// pagina.
  mime String

  tamanho Int

  /// Dimensoes, quando e imagem. Servem para reservar o espaco antes de a
  /// imagem carregar — sem isso o chat pula quando cada uma chega.
  largura Int?
  altura  Int?

  /// Quando o servidor confirmou o objeto no R2. Nulo = autorizado e nao
  /// enviado.
  prontoEm  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, prontoEm])
  @@index([messageId])
}

/// Um jogo que a comunidade ensinou ao app.
///
/// POR QUE EXISTE: a deteccao so conhece jogo que alguma LOJA declarou ter
/// instalado. Jogo fora de loja — instalado a mao, de outra plataforma, ou de
/// uma loja que ainda nao lemos — nao tem quem responda "onde voce esta". As
/// pessoas respondem.
///
/// GUARDA O EXECUTAVEL, NUNCA O CAMINHO. O caminho carrega o nome de usuario
/// do Windows quase sempre (`C:/Users/fulano/...`), entao subi-lo vazaria o
/// nome real de quem contribuiu para todo mundo, para sempre. E ele nem
/// serviria: cada pessoa instala em lugar diferente, enquanto o nome do
/// executavel e o mesmo em toda maquina.
model JogoDaComunidade {
  id String @id @default(cuid())

  /// O executavel normalizado — minusculas, sem extensao, sem pontuacao.
  /// E a chave de deduplicacao: `VALORANT-Win64-Shipping.exe` e
  /// `valorant-win64-shipping.EXE` sao a mesma sugestao.
  chave String @unique

  /// Como o executavel foi visto, para a fila mostrar algo reconhecivel.
  /// Nao e usado para casar — quem casa e a `chave`.
  executavel String

  /// O nome que aparece na atividade. Editavel na revisao: quem sugere
  /// costuma mandar o nome do processo, e nem sempre e o nome do jogo.
  nome String

  status StatusDeJogo @default(PENDENTE)

  /// Quem revisou, e quando. Um jogo aprovado passa a valer para TODA a base,
  /// entao precisa ter dono.
  revisadoPor String?
  revisadoEm  DateTime?

  sugestoes SugestaoDeJogo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A fila e sempre filtrada por status; sem indice ela varre a tabela.
  @@index([status])
}

/// Quem sugeriu o que.
///
/// Tabela propria, e nao um contador na linha do jogo, porque contador
/// inflavel e pior do que contador nenhum: uma pessoa clicando dez vezes faria
/// "dez pessoas pediram" parecer sinal forte quando nao e. Com o par unico, o
/// numero volta a significar o que diz.
///
/// Guarda QUEM de proposito, para haver a quem responsabilizar por enxurrada
/// de sugestao inventada. E o mesmo raciocinio do log de auditoria.
model SugestaoDeJogo {
  id     String           @id @default(cuid())
  jogoId String
  jogo   JogoDaComunidade @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jogoId, userId])
  @@index([userId])
}

enum StatusDeJogo {
  PENDENTE
  APROVADO
  /// Recusado fica na tabela em vez de sumir: apagar faria a mesma sugestao
  /// voltar para a fila na proxima vez que alguem abrisse o jogo.
  RECUSADO
}

/// Onde um servidor esta na fila da vitrine.
enum VitrineStatus {
  /// Padrao. Nao aparece, e ninguem pediu nada.
  PRIVADO
  /// O dono pediu para aparecer. Esperando revisao.
  PENDENTE
  /// Aparece em "Explorar comunidades".
  APROVADO
  /// Recusado. Fica assim em vez de voltar a PRIVADO para o mesmo pedido nao
  /// reaparecer na fila toda vez que o dono mexer no interruptor.
  RECUSADO
}

/// Feature flag / kill switch.
///
/// UMA LINHA POR CHAVE, e so das chaves que a equipe MEXEU. A ausencia de
/// linha nao e erro: significa "use o padrao do codigo"
/// (`@aether/shared/flags`). Isso mantem a tabela pequena e deixa o padrao
/// versionado junto do codigo que o consome.
///
/// NAO E CONFIG DE PRODUTO nem experimento A/B — e o freio de emergencia:
/// durante uma enxurrada de cadastro, a equipe vira `registro_aberto` para
/// `false` sem deploy. A propagacao nao e instantanea (cache de segundos no
/// processo que le), e isso esta documentado no ponto de leitura.
///
/// A chave e o `@id`: o conjunto e conhecido e pequeno, e um id sintetico so
/// somaria uma coluna sem uso.
model Flag {
  chave  String  @id
  ligado Boolean @default(true)

  /// Quem virou por ultimo, e quando. Um kill switch mexido as 3h da manha
  /// precisa ter dono — mesmo raciocinio do log de auditoria.
  //
  /// RLS fica ligada na migracao, como em todo o resto: quem le e escreve e a
  /// aplicacao, nunca as roles publicas do Supabase.
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}

/// O que uma denuncia aponta.
enum AlvoDeDenuncia {
  MENSAGEM
  USUARIO
  SERVIDOR
}

enum StatusDeDenuncia {
  ABERTA
  EM_ANALISE
  RESOLVIDA
  /// Analisada e sem acao — fica na tabela em vez de sumir, para a mesma
  /// pessoa reincidente nao chegar "limpa" na proxima.
  DESCARTADA
}

/// Denuncia de abuso — a unica ferramenta de moderacao ALEM de kick/ban por
/// dono de servidor. Qualquer conta autenticada abre uma; a fila e revisada
/// pela equipe global (`ehEquipe`), que pode silenciar globalmente, apagar a
/// mensagem ou revogar sessoes.
///
/// `alvoId` e polimorfico (id de mensagem, usuario ou servidor conforme
/// `tipo`) — sem FK, porque o alvo pode ser apagado e a denuncia precisa
/// sobreviver a isso para o historico. O contexto (`snapshot`) e capturado no
/// momento da denuncia justamente porque o original pode sumir.
model Denuncia {
  id         String           @id @default(cuid())
  tipo       AlvoDeDenuncia
  alvoId     String
  /// categoria curta: "spam", "assedio", "conteudo", "outro"
  motivo     String
  detalhe    String?          @db.Text
  /// o que o alvo dizia na hora — texto da mensagem, nome do servidor, etc.
  /// O alvo pode ser apagado; sem isto a equipe revisaria no escuro.
  snapshot   String?          @db.Text

  reporterId String
  reporter   User             @relation("DenunciaReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  status       StatusDeDenuncia @default(ABERTA)
  notaEquipe   String?          @db.Text
  /// userId de quem resolveu (equipe). Sem FK: e registro, nao relacao viva.
  resolvidaPor String?
  resolvidaEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// a fila e sempre "abertas, mais antigas primeiro"
  @@index([status, createdAt])
  /// "quantas denuncias sobre este alvo" — reincidencia
  @@index([tipo, alvoId])
  @@index([reporterId])
}
