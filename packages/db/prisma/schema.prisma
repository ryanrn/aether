// Schema unico do sistema. Modelado ja pensando nas fases seguintes para que
// nenhuma fase precise reescrever tabela existente — apenas usar o que ja existe.
//
// FASE 1 usa: User, Session, Server, ServerMember, Role, MemberRole, Category,
//             Channel, Invite, AuditLog
// FASE 2 usa: ChannelOverwrite (canais privados por cargo/membro)
// FASE 3 usa: Message
// FASE 6 usa: Ban, AuditLog (expandido)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum ChannelType {
  TEXT
  VOICE
}

enum OverwriteTarget {
  ROLE
  MEMBER
}

model User {
  id                        String     @id @default(cuid())
  username                  String     @unique
  displayName               String
  email                     String     @unique
  passwordHash              String
  avatarUrl                 String?
  status                    UserStatus @default(OFFLINE)
  /// Aceita conversa direta de quem NAO e amigo, mas divide um servidor.
  ///
  /// Ligado por padrao: e o comportamento que as pessoas esperam de um app de
  /// comunidade, e quem incomoda ainda pode desligar. Amizade passa por cima
  /// disto — esta chave so governa o caminho "conheci num servidor".
  allowServerDms            Boolean    @default(true)
  /// Aceita PEDIDO DE AMIZADE de quem divide um servidor.
  ///
  /// Separada de `allowServerDms` de proposito: sao decisoes diferentes. Da
  /// para querer receber pedido de amizade e nao querer conversa direta de
  /// estranho, e o contrario tambem. Uma chave so obrigaria as duas a andarem
  /// juntas.
  ///
  /// Nao afeta o caminho por NOME DE USUARIO EXATO: quem passou o proprio nome
  /// para alguem ja decidiu ser encontravel por ali.
  allowServerFriendRequests Boolean    @default(true)
  lastSeenAt                DateTime   @default(now())
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  sessions           Session[]
  passwordResets     PasswordReset[]
  friendsAsRequester Friendship[]        @relation("FriendshipRequester")
  friendsAsAddressee Friendship[]        @relation("FriendshipAddressee")
  dmsComoA           DmChannel[]         @relation("DmUserA")
  dmsComoB           DmChannel[]         @relation("DmUserB")
  bloqueiosFeitos    Block[]             @relation("Blocker")
  bloqueiosRecebidos Block[]             @relation("Blocked")
  reacoes            Reaction[]
  memberships        ServerMember[]
  ownedServers       Server[]            @relation("ServerOwner")
  assinatura         Subscription?
  resgatesDeChave    PlanKeyRedemption[]
  anexos             Attachment[]
  messages           Message[]
  createdInvites     Invite[]
  auditEntries       AuditLog[]          @relation("AuditActor")
  bans               Ban[]               @relation("BannedUser")
  issuedBans         Ban[]               @relation("BanIssuer")

  @@index([status])
}

/// Sessao persistida. O cookie carrega um JWT assinado contendo o id da sessao;
/// manter a linha no banco permite revogar acesso (logout global, ban, troca de senha).
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Server {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String?
  ownerId   String
  owner     User     @relation("ServerOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    ServerMember[]
  roles      Role[]
  categories Category[]
  channels   Channel[]
  invites    Invite[]
  bans       Ban[]
  auditLogs  AuditLog[]

  @@index([ownerId])
}

model ServerMember {
  id       String   @id @default(cuid())
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname String?
  /// Ordem do servidor no trilho DESTA pessoa.
  ///
  /// Por membro, e nao no proprio Server: a ordem do trilho e uma preferencia
  /// de quem olha. Guardar no servidor faria arrastar um icone reordenar a
  /// tela de todo mundo que e membro dele.
  ///
  /// Empate cai no `joinedAt`, que era o criterio unico antes desta coluna —
  /// com todos em 0 (o padrao), a ordem existente nao muda.
  position Int      @default(0)
  joinedAt DateTime @default(now())

  roles      MemberRole[]
  overwrites ChannelOverwrite[] @relation("MemberOverwrite")

  @@unique([serverId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#9AA6B8")
  /// bitfield de permissoes (ver packages/shared/src/permissions.ts)
  permissions BigInt   @default(0)
  /// hierarquia: maior position = cargo mais alto
  position    Int      @default(0)
  /// cargo atribuido automaticamente a todo novo membro
  isDefault   Boolean  @default(false)
  /// cargo intocavel do dono
  isOwner     Boolean  @default(false)
  createdAt   DateTime @default(now())

  members    MemberRole[]
  overwrites ChannelOverwrite[] @relation("RoleOverwrite")

  @@unique([serverId, name])
  @@index([serverId, position])
}

model MemberRole {
  memberId   String
  member     ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([memberId, roleId])
  @@index([roleId])
}

model Category {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  channels Channel[]

  @@index([serverId, position])
}

model Channel {
  id          String      @id @default(cuid())
  serverId    String
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  topic       String?
  type        ChannelType
  position    Int         @default(0)
  /// canal privado: so quem tem overwrite de allow enxerga
  isPrivate   Boolean     @default(false)
  /// canal temporario: removido quando esvazia (fase 2/3)
  isTemporary Boolean     @default(false)
  /// limite de usuarios simultaneos em voz (null = ilimitado)
  userLimit   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  messages   Message[]
  overwrites ChannelOverwrite[]

  @@index([serverId, position])
  @@index([categoryId])
}

/// Excecoes de permissao por canal — base dos canais privados (fase 2).
model ChannelOverwrite {
  id        String          @id @default(cuid())
  channelId String
  channel   Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  target    OverwriteTarget
  roleId    String?
  role      Role?           @relation("RoleOverwrite", fields: [roleId], references: [id], onDelete: Cascade)
  memberId  String?
  member    ServerMember?   @relation("MemberOverwrite", fields: [memberId], references: [id], onDelete: Cascade)
  allow     BigInt          @default(0)
  deny      BigInt          @default(0)

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
  @@index([channelId])
}

/// Mensagens de canal de texto (fase 3).
/// Uma mensagem pertence a UM canal de servidor OU a UMA conversa direta —
/// nunca aos dois, nunca a nenhum. Quem garante isso e um CHECK no banco
/// (ver a migracao 20260826..._dm), porque convencao em codigo nao sobrevive
/// ao primeiro caminho novo de escrita.
///
/// Por que uma tabela so, e nao uma `DirectMessage` separada: hoje a logica de
/// mensagem e fina (um create, duas leituras), mas editar, apagar e responder
/// vao chegar. Com duas tabelas eles chegam duas vezes, e duas copias da mesma
/// regra divergem.
model Message {
  id          String     @id @default(cuid())
  channelId   String?
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dmChannelId String?
  dmChannel   DmChannel? @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String     @db.Text
  replyToId   String?
  replyTo     Message?   @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]  @relation("MessageReply")
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())

  reactions Reaction[]
  anexos    Attachment[]

  @@index([channelId, createdAt])
  @@index([dmChannelId, createdAt])
  @@index([authorId])
}

/// Reacao de uma pessoa a uma mensagem.
///
/// O `@@unique` e o coracao do modelo: ele faz "uma reacao por pessoa, por
/// emoji, por mensagem" ser garantia do BANCO. Sem ele, clicar duas vezes
/// rapido — ou dois aparelhos da mesma pessoa ao mesmo tempo — criaria linhas
/// repetidas, e a contagem passaria a mentir sem nada quebrar visivelmente.
///
/// Ele tambem torna o ALTERNAR barato: em vez de "contar, decidir, gravar",
/// da para tentar criar e tratar a colisao como "ja existe, entao remova".
///
/// O emoji e guardado como TEXTO (o proprio caractere), e nao como id de um
/// catalogo. Catalogo envelhece: emoji novo entra no Unicode todo ano, e um id
/// nosso obrigaria a manter uma tabela de-para para sempre. O caractere ja e o
/// identificador universal — quem valida o que entra e `emojiSchema`.
model Reaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  /// Carregar as reacoes de uma pagina de mensagens percorre por messageId.
  @@index([messageId])
}

/// Conversa direta entre duas pessoas.
///
/// O PAR E ORDENADO: `userAId` guarda sempre o menor id e `userBId` o maior.
/// Com isso o unique de (userAId, userBId) impede de verdade que exista mais
/// de uma conversa para o mesmo par — inclusive quando os dois lados clicam ao
/// mesmo tempo, que e onde uma checagem em codigo perde.
///
/// Difere da `Friendship`, que indexa por DIRECAO, e a diferenca e proposital:
/// la o "quem pediu" precisa sobreviver, porque e ele que decide de que lado o
/// botao de aceitar aparece. Numa conversa nao ha esse lado — trocar A por B
/// nao muda nada — entao da para ordenar e deixar o banco garantir.
model DmChannel {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("DmUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("DmUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  /// A busca "minhas conversas" olha as duas colunas; sem este, metade sairia
  /// de varredura sequencial. Mesma razao dos dois indices em Friendship.
  @@index([userBId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([serverId])
}

model Ban {
  id         String    @id @default(cuid())
  serverId   String
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User      @relation("BanIssuer", fields: [issuedById], references: [id])
  reason     String?
  /// Banimento temporario. Nulo = permanente.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([serverId, userId])
  @@index([serverId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([serverId, createdAt])
}

/// Pedido de redefinicao de senha.
///
/// O token e guardado como HASH, nunca em claro. Se o banco vazar — ou o dump
/// de backup, que carrega esta tabela — token legivel deixaria qualquer um
/// redefinir qualquer conta. Mesmo raciocinio do `passwordHash`.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 do token que foi para o e-mail
  tokenHash String    @unique
  expiresAt DateTime
  /// carimbo de uso: o token vale UMA vez
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Amizade entre duas contas.
///
/// UMA linha por par, nao duas. Duas linhas (uma por direcao) obrigariam a
/// manter as duas em acordo a cada mudanca, e duas verdades sobre a mesma
/// relacao e como uma delas fica para tras.
///
/// A consequencia e que `requesterId`/`addresseeId` guardam QUEM PEDIU, e nao
/// uma hierarquia: depois de aceito os dois lados sao iguais, e toda consulta
/// de "meus amigos" precisa olhar as duas colunas.
///
/// O par unico e por direcao. Impedir o par invertido exigiria ordenar os ids
/// na gravacao, o que tornaria "quem pediu" irrecuperavel — entao quem checa
/// se ja existe relacao nos dois sentidos e a action, antes de criar.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum GameMetadataSource {
  /// veio do IGDB
  IGDB
  /// o IGDB nao achou (ou nao esta configurado) — vale o que o detector deu
  DETECTOR
}

/// Metadados de jogo — cache COMPARTILHADO entre todo mundo.
///
/// Compartilhado de proposito: o primeiro que abre Hollow Knight resolve a
/// capa para todos os outros. Cache por maquina faria cada pessoa pagar a
/// mesma consulta, e o IGDB limita a 4 por segundo.
///
/// **Nao ha nenhuma coluna de usuario aqui, e isso e deliberado.** A tabela
/// diz "Hollow Knight tem esta capa", nunca "fulano jogou Hollow Knight".
/// Guardar quem consultou transformaria um cache de arte em um historico de
/// habitos de jogo — que e exatamente o dado que a deteccao local se recusa a
/// mandar para o servidor.
model GameMetadata {
  id String @id @default(cuid())

  /// Nome normalizado — a chave de busca. Ver `normalize.ts`.
  lookupKey    String @unique
  /// Como o detector entregou, guardado para diagnostico do casamento.
  detectedName String
  /// O que a Activity mostra.
  displayName  String

  igdbId   Int?
  coverUrl String?
  genre    String?

  source     GameMetadataSource
  /// 0..1 — quao confiavel foi o casamento com o IGDB.
  confidence Float?

  /// Quando consultamos por ultimo. E o que decide reconsultar: linha sem
  /// capa merece nova tentativa (o IGDB cadastra jogos novos), e linha com
  /// capa envelhece devagar.
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([checkedAt])
}

/// Bloqueio de uma pessoa por outra.
///
/// DIRECIONAL: uma linha por sentido. Diferente da amizade, "A bloqueou B" e um
/// fato distinto de "B bloqueou A" — os dois podem existir ao mesmo tempo, e
/// desfazer um nao desfaz o outro.
///
/// Quem consulta, porem, olha os DOIS sentidos. Checar so um deixaria quem
/// bloqueou continuar mandando mensagem para quem bloqueou, que e o oposto do
/// que isto serve.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  /// "quem me bloqueou" percorre a outra coluna; sem este indice, metade das
  /// consultas sairia em varredura sequencial. Mesma razao dos dois em Friendship.
  @@index([blockedId])
}

/// Os planos pagos. A ESCADA importa: comparacao e por posicao, nunca por
/// igualdade — `=== PLUS` esqueceria o PRO, e quem paga mais receberia menos.
enum PlanTier {
  FREE
  PLUS
  PRO
}

/// A assinatura de uma pessoa. UMA por usuario.
///
/// POR QUE UM MODEL PROPRIO, e nao dois campos no User: cobranca traz consigo
/// estado que nao e do usuario — de qual provedor veio, qual o id la, quando
/// renova, se foi cancelada mas ainda vale ate o fim do periodo. Enfiar isso
/// no User faria a tabela mais lida do sistema crescer por um motivo que nada
/// tem a ver com identidade.
///
/// AGNOSTICA DE PROVEDOR de proposito: `provedor` e `idExterno` sao opcionais
/// e ninguem os preenche ainda. Hoje o plano e concedido a mao
/// (`scripts/definir-plano.mjs`); quando entrar Stripe ou Mercado Pago, o
/// webhook deles escreve NESTAS MESMAS colunas e o resto do sistema nao muda.
model Subscription {
  id     String   @id @default(cuid())
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   PlanTier @default(FREE)

  /// Ate quando vale. NULO = sem validade, para conta concedida a mao
  /// (equipe, teste, cortesia) que nao deve virar abobora sozinha.
  ///
  /// Quem decide se venceu e a LEITURA (`planoEfetivo`), e nao um job que
  /// altera linhas: job que falha deixa a pessoa premium para sempre, e o
  /// defeito e silencioso porque favorece quem tem.
  expiraEm DateTime?

  /// De onde veio, quando vier de algum lugar. "stripe", "mercadopago"...
  provedor  String?
  /// O id da assinatura no provedor, para o webhook achar a linha.
  idExterno String?

  /// Quem concedeu a mao, quando foi a mao. Serve para auditoria — uma conta
  /// premium que ninguem pagou precisa ter dono.
  concedidoPor String?
  motivo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O webhook do provedor chega com o id DELE, nao com o nosso.
  @@index([provedor, idExterno])
}

/// Uma chave que troca por plano.
///
/// POR QUE EXISTE: dar acesso a quem nao vai pagar — sorteio, parceiro, teste,
/// amigo — sem depender de cobranca nenhuma. E o unico caminho hoje, e vai
/// continuar existindo depois que houver pagamento, porque cobranca nao
/// resolve o caso de dar de presente.
///
/// O CODIGO NAO FICA GUARDADO. Vale o mesmo raciocinio do token de
/// recuperacao de senha: uma chave e credencial ao portador, e um vazamento do
/// banco viraria plano de graca para quem lesse a tabela. Guardamos o sha256 e
/// mostramos o codigo UMA vez, na criacao.
model PlanKey {
  id String @id @default(cuid())

  /// sha256 do codigo entregue. Unico para o resgate achar a linha.
  codigoHash String @unique
  /// Os primeiros caracteres, em claro, so para reconhecer a chave numa
  /// lista ("AE-7F3K..."). Curto de proposito: nao serve para adivinhar o
  /// resto, serve para saber de qual chave se esta falando.
  prefixo    String

  tier PlanTier

  /// Por quantos dias o plano vale ao resgatar. NULO = sem validade.
  dias Int?

  /// Quantas pessoas podem resgatar. 1 = chave pessoal; N = campanha.
  maxUsos Int @default(1)
  usos    Int @default(0)

  /// Ate quando a CHAVE aceita resgate. Diferente da validade do plano: a
  /// chave pode morrer em uma semana e dar 30 dias a quem resgatar dentro
  /// dela.
  expiraEm DateTime?

  /// Cancelada a mao. Preenchida em vez de apagar a linha, para o historico
  /// dizer que existiu e foi revogada — apagar esconderia o que aconteceu.
  revogadaEm DateTime?

  criadaPor String?
  motivo    String?
  createdAt DateTime @default(now())

  resgates PlanKeyRedemption[]

  @@index([revogadaEm])
}

/// Quem resgatou qual chave.
///
/// Existe por duas razoes, e a segunda e a que importa: dar historico, e
/// impedir que a MESMA pessoa resgate a MESMA chave de campanha varias vezes.
/// Sem o par unico, uma chave de 100 usos seria 100 meses para uma pessoa so.
model PlanKeyRedemption {
  id     String  @id @default(cuid())
  keyId  String
  key    PlanKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O que a pessoa ganhou, congelado no momento do resgate — a chave pode
  /// ser revogada depois, e o historico precisa continuar dizendo a verdade.
  tierConcedido PlanTier
  expiraEm      DateTime?

  createdAt DateTime @default(now())

  @@unique([keyId, userId])
  @@index([userId])
}

/// Um arquivo anexado a uma mensagem.
///
/// A LINHA NASCE ANTES DO ARQUIVO. Quem cria e a action que autoriza o envio,
/// depois de conferir o plano — e e ela que sorteia a `chave`. O cliente nunca
/// escolhe onde grava: se escolhesse, poderia apontar para o objeto de outra
/// pessoa ou sobrescrever o proprio anexo de uma mensagem antiga.
///
/// O CICLO tem tres estados, e nenhum deles e um booleano solto:
///   1. criada aqui, `prontoEm` nulo — autorizado, ainda nao enviado;
///   2. `prontoEm` preenchido — o servidor perguntou ao R2 e o objeto esta la,
///      com o tamanho certo;
///   3. `messageId` preenchido — virou anexo de uma mensagem.
///
/// Linha que fica no passo 1 ou 2 e lixo: alguem abriu o seletor e desistiu.
/// Ela aponta para um objeto que talvez exista no bucket, e limpar isso e
/// trabalho de faxina que ainda nao existe (anotado nas limitacoes).
model Attachment {
  id String @id @default(cuid())

  /// Quem autorizou. A mensagem so aceita anexo de quem a esta enviando.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nulo ate virar anexo de uma mensagem.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Onde o objeto vive no bucket. Sorteada pelo servidor.
  chave String @unique

  /// O nome que a pessoa deu, so para exibir e baixar. NUNCA usado para montar
  /// caminho — nome de arquivo com `../` viraria travessia de diretorio.
  nome String

  /// O tipo com que o objeto foi GRAVADO, que nao e necessariamente o que o
  /// navegador declarou: o que nao for imagem, video ou audio conhecido vira
  /// `application/octet-stream`, para o bucket publico nao servir HTML como
  /// pagina.
  mime String

  tamanho Int

  /// Dimensoes, quando e imagem. Servem para reservar o espaco antes de a
  /// imagem carregar — sem isso o chat pula quando cada uma chega.
  largura Int?
  altura  Int?

  /// Quando o servidor confirmou o objeto no R2. Nulo = autorizado e nao
  /// enviado.
  prontoEm  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, prontoEm])
  @@index([messageId])
}
