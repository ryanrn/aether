  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@aether/shared": "*"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
